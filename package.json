{
  "name": "obsidian-link-or-card",
  "version": "0.2.0",
  "description": "Choose whether a pasted URL becomes a link card or a Markdown link.",
  "license": "MIT",
  "author": "Yuto Takagi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yut0takagi/obsidian-link-or-card.git"
  },
  "homepage": "https://github.com/yut0takagi/obsidian-link-or-card#readme",
  "bugs": "https://github.com/yut0takagi/obsidian-link-or-card/issues",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "link",
    "link-card",
    "ogp",
    "paste"
  ],
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && node scripts/check-plugin.mjs && npm run build",
    "check:plugin": "node scripts/check-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
